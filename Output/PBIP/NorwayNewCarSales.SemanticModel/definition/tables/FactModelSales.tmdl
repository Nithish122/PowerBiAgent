/// Monthly model-level sales totals and source percentages used for model rankings and make-to-model drilldowns.
table FactModelSales
	column DateKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: DateKey

	column Year
		dataType: int64
		summarizeBy: none
		sourceColumn: Year

	column Month
		dataType: int64
		summarizeBy: none
		sourceColumn: Month

	column MakeKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: MakeKey

	column ModelKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: ModelKey

	column MakeName
		dataType: string
		summarizeBy: none
		sourceColumn: Make

	column ModelName
		dataType: string
		summarizeBy: none
		sourceColumn: Model

	column Quantity
		dataType: int64
		summarizeBy: sum
		sourceColumn: Quantity

	column Pct
		dataType: double
		summarizeBy: average
		sourceColumn: Pct

	partition FactModelSales = m
		mode: import
		source = #table(type table [DateKey = Int64.Type, Year = Int64.Type, Month = Int64.Type, MakeKey = Int64.Type, ModelKey = Int64.Type, MakeName = text, ModelName = text, Quantity = Int64.Type, Pct = number], {})
