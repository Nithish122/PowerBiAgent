/// Monthly make-level sales totals and source percentages used for leading-make analysis.
table FactMakeSales
	column DateKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: DateKey

	column Year
		dataType: int64
		summarizeBy: none
		sourceColumn: Year

	column Month
		dataType: int64
		summarizeBy: none
		sourceColumn: Month

	column MakeKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: MakeKey

	column MakeName
		dataType: string
		summarizeBy: none
		sourceColumn: Make

	column Quantity
		dataType: int64
		summarizeBy: sum
		sourceColumn: Quantity

	column Pct
		dataType: double
		summarizeBy: average
		sourceColumn: Pct

	partition FactMakeSales = m
		mode: import
		source = #table(type table [DateKey = Int64.Type, Year = Int64.Type, Month = Int64.Type, MakeKey = Int64.Type, MakeName = text, Quantity = Int64.Type, Pct = number], {})
