/// Trimmed make dimension used for top-ranking, filtering, and model-to-make navigation.
table DimMake
	column MakeKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: MakeKey

	column MakeName
		dataType: string
		summarizeBy: none
		sourceColumn: MakeName

	partition DimMake = m
		mode: import
		source = #table(type table [MakeKey = Int64.Type, MakeName = text], {})
