/// Model dimension aligned to make-level context for rankings and drilldown analysis.
table DimModel
	column ModelKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: ModelKey

	column MakeKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: MakeKey

	column MakeName
		dataType: string
		summarizeBy: none
		sourceColumn: MakeName

	column ModelName
		dataType: string
		summarizeBy: none
		sourceColumn: ModelName

	partition DimModel = m
		mode: import
		source = #table(type table [ModelKey = Int64.Type, MakeKey = Int64.Type, MakeName = text, ModelName = text], {})
