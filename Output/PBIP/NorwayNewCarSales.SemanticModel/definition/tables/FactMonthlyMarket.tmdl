/// Monthly market totals and indicator trends for Norway, with source-defined powertrain and CO2 measures.
table FactMonthlyMarket
	column DateKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: DateKey

	column Year
		dataType: int64
		summarizeBy: none
		sourceColumn: Year

	column Month
		dataType: int64
		summarizeBy: none
		sourceColumn: Month

	column Quantity
		dataType: int64
		summarizeBy: sum
		sourceColumn: Quantity

	column Quantity_YoY
		dataType: int64
		summarizeBy: sum
		sourceColumn: Quantity_YoY

	column Import
		dataType: int64
		summarizeBy: sum
		sourceColumn: Import

	column Import_YoY
		dataType: int64
		summarizeBy: sum
		sourceColumn: Import_YoY

	column Used
		dataType: int64
		summarizeBy: sum
		sourceColumn: Used

	column Used_YoY
		dataType: int64
		summarizeBy: sum
		sourceColumn: Used_YoY

	column Avg_CO2
		dataType: double
		summarizeBy: average
		sourceColumn: Avg_CO2

	column Bensin_Co2
		dataType: double
		summarizeBy: average
		sourceColumn: Bensin_Co2

	column Diesel_Co2
		dataType: double
		summarizeBy: average
		sourceColumn: Diesel_Co2

	column Quantity_Diesel
		dataType: int64
		summarizeBy: sum
		sourceColumn: Quantity_Diesel

	column Diesel_Share
		dataType: double
		summarizeBy: average
		sourceColumn: Diesel_Share

	column Diesel_Share_LY
		dataType: double
		summarizeBy: average
		sourceColumn: Diesel_Share_LY

	column Quantity_Hybrid
		dataType: int64
		summarizeBy: sum
		sourceColumn: Quantity_Hybrid

	column Quantity_Electric
		dataType: int64
		summarizeBy: sum
		sourceColumn: Quantity_Electric

	column Import_Electric
		dataType: int64
		summarizeBy: sum
		sourceColumn: Import_Electric

	partition FactMonthlyMarket = m
		mode: import
		source = #table(type table [DateKey = Int64.Type, Year = Int64.Type, Month = Int64.Type, Quantity = Int64.Type, Quantity_YoY = Int64.Type, Import = Int64.Type, Import_YoY = Int64.Type, Used = Int64.Type, Used_YoY = Int64.Type, Avg_CO2 = number, Bensin_Co2 = number, Diesel_Co2 = number, Quantity_Diesel = Int64.Type, Diesel_Share = number, Diesel_Share_LY = number, Quantity_Hybrid = Int64.Type, Quantity_Electric = Int64.Type, Import_Electric = Int64.Type], {})
