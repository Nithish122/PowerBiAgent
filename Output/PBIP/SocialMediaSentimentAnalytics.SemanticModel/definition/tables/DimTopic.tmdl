table DimTopic
	column TopicKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: TopicKey

	column TopicName
		dataType: string
		summarizeBy: none
		sourceColumn: TopicName

	partition DimTopic = m
		mode: import
		source =
				let
					Source = #table(
						type table [TopicKey = Int64.Type, TopicName = text],
						{{1, "Technology"}, {2, "Finance"}, {3, "Politics"}, {4, "Sports"}, {5, "Other"}}
					)
				in
					Source
