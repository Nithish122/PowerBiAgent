table DimLanguage
	column LanguageKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: LanguageKey

	column LanguageName
		dataType: string
		summarizeBy: none
		sourceColumn: LanguageName

	partition DimLanguage = m
		mode: import
		source =
				let
					Source = #table(
						type table [LanguageKey = Int64.Type, LanguageName = text],
						{{1, "English"}, {2, "Spanish"}, {3, "French"}, {4, "German"}, {5, "Urdu"}, {6, "Other"}}
					)
				in
					Source
